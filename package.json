{
  "name": "content-morphia-presentation-layer",
  "private": true,
  "description": "Content Morphia Report Kit and tooling. The kit itself has no build step; these packages serve previews, checks, the offline packaging mode and the design bundle.",
  "type": "module",
  "scripts": {
    "preview": "node tools/preview.mjs",
    "check": "node checks/run.mjs",
    "test": "node checks/test.mjs",
    "index": "node tools/index.mjs",
    "links": "node checks/links.mjs",
    "pack": "node tools/pack.mjs",
    "bundle": "node tools/bundle.mjs",
    "bundle:check": "node tools/bundle-check.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "echarts": "5.5.1",
    "playwright": "1.56.1"
  }
}
